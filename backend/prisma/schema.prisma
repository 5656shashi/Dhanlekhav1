// DhanLekha — Prisma Schema
// SQLite database schema for the entire application (Simple Setup)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  phone             String    @unique
  email             String?   @unique
  name              String?
  avatarUrl         String?
  pinHash           String?
  deviceId          String?
  fcmToken          String?
  
  // KYC
  kycStatus         String    @default("PENDING")
  aadhaarHash       String?   // hashed, never stored raw
  panHash           String?
  kycVerifiedAt     DateTime?
  
  // Subscription
  plan              String    @default("FREE")
  planExpiresAt     DateTime?
  
  // Security
  twoFAEnabled      Boolean   @default(false)
  twoFASecret       String?
  biometricEnabled  Boolean   @default(true)
  lastLoginAt       DateTime?
  lastActiveAt      DateTime?
  
  // Dead-Man Switch
  deadManEnabled    Boolean   @default(true)
  deadManDays       Int       @default(180)
  deadManTriggeredAt DateTime?
  
  // Blockchain
  walletAddress     String?
  
  // Metadata
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  refreshTokens     RefreshToken[]
  otps              OTP[]
  documents         Document[]
  nominees          Nominee[]
  connectedAccounts ConnectedAccount[]
  transactions      Transaction[]
  reports           WealthReport[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  
  @@map("users")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  deviceId  String?
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("refresh_tokens")
}

model OTP {
  id        String   @id @default(uuid())
  userId    String?
  phone     String?
  email     String?
  code      String
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("otps")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id              String          @id @default(uuid())
  userId          String
  title           String
  docType         String
  category        String?
  description     String?
  
  // File storage
  fileUrl         String          // encrypted S3 / local path
  fileName        String
  fileSize        Int
  mimeType        String
  encryptionKey   String          // per-document AES key (encrypted with master key)
  
  // AI / OCR
  ocrStatus       String          @default("PENDING")
  ocrData         Json?           // Extracted fields
  ocrConfidence   Float?
  fraudScore      Float?
  
  // Blockchain
  blockchainStatus String          @default("UNVERIFIED")
  documentHash    String?          // SHA-256
  txHash          String?          // blockchain tx hash
  blockNumber     BigInt?
  contractRef     String?
  verifiedAt      DateTime?
  
  // Validity
  issuedBy        String?
  issuedDate      DateTime?
  expiryDate      DateTime?
  
  // Status
  status          String          @default("ACTIVE")
  isDeleted       Boolean         @default(false)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nomineeAccess   NomineeDocumentAccess[]
  reportItems     ReportItem[]
  
  @@map("documents")
}

// ─────────────────────────────────────────────
// NOMINEES
// ─────────────────────────────────────────────

model Nominee {
  id              String        @id @default(uuid())
  userId          String
  name            String
  relation        String
  phone           String?
  email           String?
  aadhaarHash     String?
  
  // Type
  nomineeType     String        @default("INDIVIDUAL")
  ngoName         String?       // for NGO type
  ngoRegNo        String?
  
  // Access
  accessType      String        @default("READ_ONLY")
  allocationPct   Float         @default(0)  // 0-100
  conditions      Json?         // trigger conditions
  
  // Verification
  isVerified      Boolean       @default(false)
  verifiedAt      DateTime?
  
  // Blockchain
  smartContractRef String?
  txHash          String?
  
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentAccess  NomineeDocumentAccess[]
  
  @@map("nominees")
}

model NomineeDocumentAccess {
  id          String   @id @default(uuid())
  nomineeId   String
  documentId  String
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?
  
  nominee     Nominee  @relation(fields: [nomineeId], references: [id], onDelete: Cascade)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@unique([nomineeId, documentId])
  @@map("nominee_document_access")
}

// ─────────────────────────────────────────────
// CONNECTED ACCOUNTS
// ─────────────────────────────────────────────

model ConnectedAccount {
  id              String          @id @default(uuid())
  userId          String
  provider        String          // "hdfc", "zerodha", "upstox", "groww", etc.
  providerName    String
  accountType     String
  accessToken     String?         // encrypted
  refreshToken    String?         // encrypted
  tokenExpiresAt  DateTime?
  
  // Synced data
  accountNumber   String?         // masked
  holdingsJson    Json?           // latest holdings snapshot
  lastSyncedAt    DateTime?
  syncStatus      String          @default("PENDING")
  
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, provider])
  @@map("connected_accounts")
}

// ─────────────────────────────────────────────
// WEALTH REPORTS
// ─────────────────────────────────────────────

model WealthReport {
  id              String        @id @default(uuid())
  userId          String
  title           String        @default("Wealth Report")
  slug            String        @unique @default(uuid())
  
  // Config
  includeNetworth Boolean       @default(true)
  totalValue      Float?
  
  // Sharing
  shareToken      String        @unique @default(uuid())
  shareUrl        String?
  expiresAt       DateTime?
  viewCount       Int           @default(0)
  
  // Blockchain
  reportHash      String?
  txHash          String?
  
  // Status
  status          String        @default("GENERATING")
  pdfUrl          String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           ReportItem[]
  
  @@map("wealth_reports")
}

model ReportItem {
  id          String        @id @default(uuid())
  reportId    String
  documentId  String?
  assetName   String
  assetType   String
  value       Float
  metadata    Json?
  
  report      WealthReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  document    Document?     @relation(fields: [documentId], references: [id])
  
  @@map("report_items")
}

// ─────────────────────────────────────────────
// TRANSACTIONS (Payment)
// ─────────────────────────────────────────────

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  razorpayOrderId String?           @unique
  razorpayPaymentId String?         @unique
  amount          Float
  currency        String            @default("INR")
  status          String            @default("PENDING")
  plan            String
  metadata        Json?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  user            User              @relation(fields: [userId], references: [id])
  
  @@map("transactions")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}
