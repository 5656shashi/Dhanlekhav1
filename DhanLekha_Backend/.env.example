# ─────────────────────────────────────────────
# DhanLekha Backend — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dhanlekha?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Encryption (AES-256)
ENCRYPTION_KEY="your-32-byte-hex-encryption-key"
ENCRYPTION_IV="your-16-byte-hex-iv"

# OTP / SMS (Twilio)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# Email (Nodemailer / SendGrid)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="SG.xxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="noreply@dhanlekha.com"
FROM_NAME="DhanLekha"

# File Storage (AWS S3 or local)
STORAGE_PROVIDER="local"     # "local" | "s3"
LOCAL_UPLOAD_PATH="./uploads"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="dhanlekha-vault"

# Blockchain (Polygon)
POLYGON_RPC_URL="https://polygon-rpc.com"
POLYGON_CHAIN_ID=137
VAULT_CONTRACT_ADDRESS="0xYourDeployedVaultContractAddress"
DEPLOYER_PRIVATE_KEY="your-deployer-wallet-private-key"

# Razorpay (TEST mode - no real money)
# Get your own test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_1DP5mmOlF5G5ag"
RAZORPAY_KEY_SECRET="thisShouldBeYourTestSecret"
RAZORPAY_WEBHOOK_SECRET="dhanlekha_webhook_secret_test"

# Pricing (in paise: 100 paise = ₹1)
PRICE_DOCUMENT_UPLOAD=500       # ₹5
PRICE_API_INTEGRATION=1000      # ₹10

# CORS
ALLOWED_ORIGINS="http://localhost:3000,https://app.dhanlekha.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# OTP Config
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# Dead-Man Switch (cron schedule)
DEAD_MAN_CRON="0 9 * * *"     # Daily at 9 AM

# App URLs
FRONTEND_URL="https://app.dhanlekha.com"
BACKEND_URL="https://api.dhanlekha.com"
